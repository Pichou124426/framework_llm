  {id: 'R27', name: 'Corpus sensitive data exposure via excessive indexing', name_technique: 'Internal Oversharing & Data Amplification', category: 'EXF', cia: 'C', asset: 'CORPUS', assets: ['CORPUS'], description: 'Sensitive document exposure through over-indexing of the corpus.', source: 'CWE-212 / OWASP LLM Top 10 (2025)', arxiv: 'https://cwe.mitre.org/data/definitions/212.html', conference: 'CWE/OWASP (2025)', has_attack: true},
  {id: 'R28', name: 'Output availability risk from vendor dependency', name_technique: 'Vendor Transparency & Infrastructure Dependency', category: 'DEG', cia: 'A; C', asset: 'OUTPUT', assets: ['OUTPUT'], description: 'Unavailability or loss of control due to external LLM vendor dependency.', source: 'NIST AI 600-1 (2024)', arxiv: 'https://doi.org/10.6028/NIST.AI.600-1', conference: 'NIST (2024)', has_attack: false},
  {id: 'R29', name: 'Corpus perturbation via cross-modal poisoning', name_technique: 'Cross-Modal Knowledge Poisoning', category: 'POI', cia: 'I', asset: 'CORPUS', assets: ['CORPUS'], description: 'Reasoning perturbation through external multimodal injection (MM-RAG).', source: 'Ha et al. (MM-PoisonRAG)', arxiv: 'https://arxiv.org/abs/2502.17832', conference: '', has_attack: true},
  {id: 'R30', name: 'Output opinion manipulation via thematic poisoning', name_technique: 'Topic-Level Opinion Manipulation', category: 'POI', cia: 'I', asset: 'OUTPUT', assets: ['OUTPUT'], description: 'Model opinion manipulation through thematic corpus poisoning.', source: 'Gong et al. (Topic-FlipRAG)', arxiv: 'https://arxiv.org/abs/2502.01386', conference: 'https://dl.acm.org/doi/10.5555/3766078.3766274', has_attack: true},
  {id: 'R31', name: 'Corpus verbatim extraction via adversarial strings', name_technique: 'Adversarial String Extraction (MARAGE)', category: 'EXF', cia: 'C', asset: 'CORPUS', assets: ['CORPUS'], description: 'Verbatim document extraction through adversarial string injection.', source: 'Hu et al. (MARAGE)', arxiv: 'https://arxiv.org/abs/2502.04360', conference: '', has_attack: true},
  {id: 'R32', name: 'Corpus corruption via query-embedded backdoor triggers', name_technique: 'Retrieval Backdoor Attack', category: 'POI', cia: 'I', asset: 'CORPUS', assets: ['CORPUS'], description: 'Backdoor activation through trigger patterns embedded in queries.', source: 'Xue et al. (BadRAG)', arxiv: 'https://arxiv.org/abs/2406.00083', conference: '', has_attack: true},
  {id: 'R33', name: 'Corpus integrity degradation via silver noise injection', name_technique: 'Silver Noise Attack', category: 'POI', cia: 'I', asset: 'CORPUS', assets: ['CORPUS'], description: 'Retrieval degradation through partially correct evidence (silver noise).', source: 'Liang et al. (SafeRAG)', arxiv: 'https://arxiv.org/abs/2501.18636', conference: 'https://aclanthology.org/2025.acl-long.230/', has_attack: true},
  {id: 'R34', name: 'Output corruption via inter-source contradictions', name_technique: 'Inter-Context Conflict Attack', category: 'POI', cia: 'I', asset: 'OUTPUT', assets: ['OUTPUT'], description: 'Incorrect response generation caused by inter-source contradictions.', source: 'Liang et al. (SafeRAG)', arxiv: 'https://arxiv.org/abs/2501.18636', conference: 'https://aclanthology.org/2025.acl-long.230/', has_attack: true},
  {id: 'R35', name: 'Output contamination via covert advertising injection', name_technique: 'Soft Ad Attack', category: 'POI', cia: 'I', asset: 'OUTPUT', assets: ['OUTPUT'], description: 'Implicit advertising content injection into generated responses.', source: 'Liang et al. (SafeRAG)', arxiv: 'https://arxiv.org/abs/2501.18636', conference: 'https://aclanthology.org/2025.acl-long.230/', has_attack: true},
  {id: 'R36', name: 'Output suppression via fake security warnings', name_technique: 'White Denial-of-Service (DoS) Attack', category: 'DEG', cia: 'I', asset: 'OUTPUT', assets: ['OUTPUT'], description: 'Response refusal induced by fake security warnings (white DoS).', source: 'Liang et al. (SafeRAG)', arxiv: 'https://arxiv.org/abs/2501.18636', conference: 'https://aclanthology.org/2025.acl-long.230/', has_attack: true},
  {id: 'R37', name: 'Membership inference via interrogation queries', name_technique: 'Interrogation Attack (Stealthy Membership Inference)', category: 'INF', cia: 'C', asset: 'MEMBERSHIP', assets: ['MEMBERSHIP'], description: 'Membership inference through targeted natural language interrogation queries.', source: 'Naseh et al. 2025', arxiv: 'https://arxiv.org/abs/2502.00306', conference: 'https://doi.org/10.1145/3719027.3744840', has_attack: true},
  {id: 'R38', name: 'Embeddings information leakage via embedding model vulnerabilities', name_technique: 'Embedding Information Leakage', category: 'INF', cia: 'C', asset: 'EMBEDDINGS', assets: ['EMBEDDINGS'], description: 'Sensitive information leakage through embedding model vulnerabilities.', source: 'Song & Raghunathan 2020', arxiv: 'https://arxiv.org/abs/2004.00053', conference: 'https://doi.org/10.1145/3372297.3417270', has_attack: true},
  {id: 'R39', name: 'Membership inference via multimodal perturbation and masking', name_technique: 'Multimodal Membership Inference Attack (MrM)', category: 'INF', cia: 'C', asset: 'MEMBERSHIP', assets: ['MEMBERSHIP'], description: 'Image membership inference through perturbation and masking attacks.', source: 'Yang et al. (MrM)', arxiv: 'https://arxiv.org/abs/2506.07399', conference: '', has_attack: true},
  {id: 'R40', name: 'Corpus knowledge base extraction via progressive queries', name_technique: 'Knowledge Base Extraction Attack (Inter-class & Intra-class)', category: 'INF', cia: 'C', asset: 'CORPUS', assets: ['CORPUS'], description: 'Knowledge base reconstruction through progressive extraction queries.', source: 'Jiang et al. 2024', arxiv: 'https://arxiv.org/abs/2411.14110', conference: '', has_attack: true}
] AS props
CREATE (n:Risk) SET n = props;

// --- MITIGATIONS (72) ---
UNWIND [
  {id: 'MIT0', name: 'Anonymization', type: 'PREVENTIVE', active: true, category: 'Secure retrieval', description: 'Remove personally identifiable information from documents before ingestion to prevent leakage of sensitive data.', source: 'Ammann et al. 2025', arxiv: 'https://arxiv.org/abs/2505.08728', conference: 'IEEE SDS 2025 (DOI: 10.1109/SDS66131.2025.00024)'},
  {id: 'MIT1', name: 'Pseudonymization', type: 'PREVENTIVE', active: true, category: 'Secure retrieval', description: 'Replace sensitive identifiers with reversible placeholders to allow future re‑identification while protecting privacy.', source: null, arxiv: 'https://arxiv.org/abs/2505.08728', conference: 'IEEE SDS 2025 (DOI: 10.1109/SDS66131.2025.00024)'},
  {id: 'MIT2', name: 'Synthetic data', type: 'PREVENTIVE', active: true, category: 'Secure retrieval', description: 'Generate synthetic training data to augment or replace real data, reducing exposure of actual records.', source: null, arxiv: 'https://arxiv.org/abs/2505.08728', conference: 'IEEE SDS 2025 (DOI: 10.1109/SDS66131.2025.00024)'},
  {id: 'MIT3', name: 'Access limitation', type: 'PREVENTIVE', active: true, category: 'System hardening', description: 'Limit who or what can write or access the retrieval database; enforce access control policies to reduce corruption or leakage.', source: null, arxiv: 'https://arxiv.org/abs/2505.08728', conference: 'IEEE SDS 2025 (DOI: 10.1109/SDS66131.2025.00024)'},
  {id: 'MIT4', name: 'Reinforcement of system instructions', type: 'PREVENTIVE', active: true, category: 'System hardening', description: 'Strengthen system prompts and safety instructions to constrain the model’s responses and prevent exploitation through retrieved content.', source: null, arxiv: 'https://arxiv.org/abs/2505.08728', conference: 'IEEE SDS 2025 (DOI: 10.1109/SDS66131.2025.00024)'},
  {id: 'MIT5', name: 'Input validation', type: 'PREVENTIVE', active: true, category: 'System hardening', description: 'Validate and sanitize inputs and retrieved content to detect and remove malicious patterns or instructions.', source: null, arxiv: 'https://arxiv.org/abs/2505.08728', conference: 'IEEE SDS 2025 (DOI: 10.1109/SDS66131.2025.00024)'},
  {id: 'MIT6', name: 'Evaluation framework', type: 'DETECTIVE', active: true, category: 'System hardening', description: 'Establish systematic evaluation for retrieval and generation, including monitoring retrieval quality and detection of malicious content.', source: null, arxiv: 'https://arxiv.org/abs/2505.08728', conference: 'IEEE SDS 2025 (DOI: 10.1109/SDS66131.2025.00024)'},
  {id: 'MIT7', name: 'Self‑hosting AI models', type: 'PREVENTIVE', active: true, category: 'Privacy and control', description: 'Host AI models locally or in trusted environments to avoid exposure through third‑party APIs and reduce vulnerability during embedding.', source: null, arxiv: 'https://arxiv.org/abs/2505.08728', conference: 'IEEE SDS 2025 (DOI: 10.1109/SDS66131.2025.00024)'},
  {id: 'MIT8', name: 'Adding noise', type: 'PREVENTIVE', active: true, category: 'Privacy and control', description: 'Add random noise to embeddings or retrieval results to obfuscate sensitive data and reduce the risk of embedding inversion.', source: null, arxiv: 'https://arxiv.org/abs/2505.08728', conference: 'IEEE SDS 2025 (DOI: 10.1109/SDS66131.2025.00024)'},
  {id: 'MIT9', name: 'Distance threshold', type: 'PREVENTIVE', active: true, category: 'Retrieval control', description: 'Apply a similarity threshold to ensure only highly relevant documents are retrieved, reducing exposure to irrelevant or adversarial data.', source: null, arxiv: 'https://arxiv.org/abs/2505.08728', conference: 'IEEE SDS 2025 (DOI: 10.1109/SDS66131.2025.00024)'},
  {id: 'MIT10', name: 'Summarization', type: 'REACTIVE', active: true, category: 'Retrieval control', description: 'Summarize retrieved content before feeding it to the generator, reducing the amount of exposed data and potential for leakage.', source: null, arxiv: 'https://arxiv.org/abs/2505.08728', conference: 'IEEE SDS 2025 (DOI: 10.1109/SDS66131.2025.00024)'},
  {id: 'MIT11', name: 'Re‑ranking', type: 'REACTIVE', active: true, category: 'Retrieval control', description: 'Re‑rank retrieved passages based on relevance and quality to filter out adversarial or low‑quality information.', source: null, arxiv: 'https://arxiv.org/abs/2505.08728', conference: 'IEEE SDS 2025 (DOI: 10.1109/SDS66131.2025.00024)'},
  {id: 'MIT12', name: 'Minimization of exposure', type: 'PREVENTIVE', active: true, category: 'Privacy and control', description: 'Reduce the scope of user‑facing APIs and minimize the exposure of retrieval and generation functions to mitigate exploitation.', source: null, arxiv: 'https://arxiv.org/abs/2505.08728', conference: 'IEEE SDS 2025 (DOI: 10.1109/SDS66131.2025.00024)'},
  {id: 'MIT13', name: 'Sanitization and anomaly detection for invisible injection', type: 'PREVENTIVE', active: true, category: 'Data ingestion', description: 'Detect anomalous Unicode sequences (diacritical stacking, zero‑width characters, homoglyphs) and bidirectional control characters; apply Unicode normalization, remove zero‑width characters, and use OCR pipelines to strip hidden characters and formatting.', source: 'Hidden Threat & RAG-PULL', arxiv: 'https://arxiv.org/abs/2507.05093', conference: 'ACM AISec 2025 (DOI: 10.1145/3733799.3762976)'},
  {id: 'MIT14', name: 'Perplexity‑based filtering', type: 'DETECTIVE', active: true, category: 'RAG poisoning defense', description: 'Use a perplexity threshold (e.g., 99th percentile) to filter out passages with anomalous language patterns that may indicate poisoning.', source: 'Eyes‑on‑Me', arxiv: 'https://arxiv.org/abs/2510.00586', conference: 'Preprint'},
  {id: 'MIT15', name: 'Paraphrase (query rewriting)', type: 'PREVENTIVE', active: true, category: 'RAG poisoning defense', description: 'Rewrite the input query before retrieval to mitigate optimized attack vectors and reduce the effectiveness of poisoning.', source: null, arxiv: 'https://arxiv.org/abs/2510.00586', conference: 'Preprint'},
  {id: 'MIT16', name: 'Self‑Reminder (defensive prompt)', type: 'PREVENTIVE', active: true, category: 'RAG poisoning defense', description: 'Add defensive instructions to the prompt reminding the model to ignore malicious patterns in the retrieved content.', source: null, arxiv: 'https://arxiv.org/abs/2510.00586', conference: 'Preprint'},
  {id: 'MIT17', name: 'Self‑Examination', type: 'DETECTIVE', active: true, category: 'RAG poisoning defense', description: 'Use a larger language model to self‑check the generated answer and flag or revise outputs based on their alignment with safe behaviors; neutralizes many attacks but incurs high resource cost.', source: null, arxiv: 'https://arxiv.org/abs/2510.00586', conference: 'Preprint'},
  {id: 'MIT18', name: 'Noise insertion', type: 'PREVENTIVE', active: true, category: 'RAG poisoning defense', description: 'Insert random tokens or characters into the input to disrupt the optimized tokens of a poisoning attack, reducing its effectiveness.', source: null, arxiv: 'https://arxiv.org/abs/2510.00586', conference: 'Preprint'},
  {id: 'MIT19', name: 'Grammar checker for low‑level perturbations', type: 'DETECTIVE', active: true, category: 'Low‑level perturbation defense', description: 'Use grammar checkers to detect and remove typos or noisy inputs before ingestion; however, this strategy may drop legitimate text and does not detect all adversarial examples.', source: 'Typos that Broke the RAG’s Back', arxiv: 'https://arxiv.org/abs/2404.13948', conference: 'https://aclanthology.org/2024.findings-emnlp.161/'},
  {id: 'MIT20', name: 'Fairness defense layers', type: 'PREVENTIVE', active: true, category: 'Fairness backdoor defense', description: 'Implement complementary layers such as retriever provenance logging, document trust scoring, protected‑attribute rewriting (removing or anonymizing protected attributes), semantic outlier detection on retrieved results, and post‑generation fairness scans to identify and mitigate unfair backdoor behavior.', source: 'BiasRAG', arxiv: 'https://arxiv.org/abs/2509.22486', conference: 'https://aclanthology.org/2025.emnlp-main.804/'},
  {id: 'MIT21', name: 'BiasDef post‑processing filter', type: 'DETECTIVE', active: true, category: 'Fairness backdoor defense', description: 'Construct a feature space using similarity and perspective scores; apply KL divergence to set a threshold separating benign and adversarial passages; filter out outliers and recover any false negatives to mitigate bias injection attacks.', source: 'BiasDef', arxiv: 'https://arxiv.org/abs/2512.00804', conference: 'Preprint'},
  {id: 'MIT22', name: 'Input‑ and output‑level detection', type: 'DETECTIVE', active: true, category: 'Knowledge extraction defense', description: 'At input level: use intention detection, keyword filtering, and defensive instructions to identify malicious queries; at output level: apply perplexity-based detection, content detection and redaction, and LLM-based filtering to block sensitive information.', source: 'Silent Leaks (IKEA)', arxiv: 'https://arxiv.org/abs/2505.15420', conference: 'https://openreview.net/forum?id=F5TD0OExsf'},
  {id: 'MIT23', name: 'Fake news detection and knowledge consolidation', type: 'DETECTIVE', active: true, category: 'Few‑shot poisoning defense', description: 'Use LLM-based fake‑news detectors (e.g., FakeWatch), divide-and-vote approaches, consolidate‑then‑select strategies, perplexity and ROUGE-based detection, and agent-based frameworks to identify and filter adversarial passages; however, current methods have limited effectiveness against few-shot knowledge poisoning.', source: 'ADMIT', arxiv: 'https://arxiv.org/abs/2510.13842', conference: 'Preprint'},
  {id: 'MIT24', name: 'Response rewriting', type: 'REACTIVE', active: true, category: 'Membership inference defense', description: 'Rewrite the model’s output (instead of the query) using an LLM to distort membership cues and reduce the discriminability of membership signals when using generation budget side channels.', source: 'BudgetLeak', arxiv: 'https://arxiv.org/abs/2511.12043', conference: 'Preprint'},
  {id: 'MIT25', name: 'RAGDEFENDER (clustering & concentration)', type: 'DETECTIVE', active: true, category: 'Knowledge poisoning defense', description: 'Group retrieved passages using clustering and concentration-based algorithms to identify adversarial passages; filter them out without additional LLM inference, significantly reducing attack success and improving robustness.', source: 'Rescuing the Unpoisoned', arxiv: 'https://arxiv.org/abs/2511.01268', conference: 'ACSAC 2025'},
  {id: 'MIT26', name: 'Constrained generation protocol', type: 'PREVENTIVE', active: true, category: 'Generation risk control', description: 'Use parameters such as the number of retrieved examples, generation set size, and similarity threshold to control the generation process; conformal analysis provides an upper bound on generation risk, ensuring reliability even under distribution shifts.', source: 'C-RAG', arxiv: 'https://arxiv.org/abs/2402.03181', conference: 'ICML 2024, PMLR 235'},
  {id: 'MIT27', name: 'Self‑RAG (adaptive retrieval & reflection)', type: 'REACTIVE', active: true, category: 'Adaptive retrieval', description: 'Use self-reflection tokens to indicate when retrieval is needed and critique tokens to evaluate retrieved segments; the model adaptively decides when to retrieve and how to critique its output, improving factuality and reducing exposure.', source: 'Self‑RAG', arxiv: 'https://arxiv.org/abs/2310.11511', conference: 'ICLR 2024 (Oral, top 1%) https://openreview.net/forum?id=hSyW5go0v8'},
  {id: 'MIT28', name: 'MemoRAG (global memory & dual system)', type: 'REACTIVE', active: true, category: 'Adaptive retrieval', description: 'Employ a dual‑system architecture: a lightweight long-range system builds a global memory of the context and provides draft answers, and a more expressive system retrieves information based on those clues to generate the final answer, enabling robust processing of long contexts.', source: 'MemoRAG', arxiv: 'https://arxiv.org/abs/2409.05591', conference: 'TheWebConf (WWW) 2025 (DOI: 10.1145/3696410.3714805)'},
  {id: 'MIT29', name: 'Multi‑agent retrieval', type: 'REACTIVE', active: true, category: 'Adaptive retrieval', description: 'Delegate retrieval tasks to multiple specialized agents (e.g., one per data source or query type); they collaborate within a modular framework to produce more accurate and efficient retrievals, mitigating system limitations and data contamination.', source: 'Multi‑Agent RAG', arxiv: 'https://arxiv.org/abs/2412.05838', conference: null},
  {id: 'MIT30', name: 'Retrieved data & prompt validation', type: 'PREVENTIVE', active: true, category: 'Data ingestion & validation', description: 'Enterprises should validate retrieved documents and prompts for malicious strings before they are used in RAG. Tools like Microsoft Prompt Shield can detect malicious patterns, although false positives may limit legitimate queries.', source: 'RoyChowdhury et al. (ConfusedPilot)', arxiv: 'https://arxiv.org/abs/2408.04870', conference: 'Preprint'},
  {id: 'MIT31', name: 'Information flow control in LLM', type: 'PREVENTIVE', active: true, category: 'System hardening', description: 'Implement dynamic information‑flow control inside the LLM so that its outputs always respect confidentiality and integrity policies, regardless of the retrieval results or user permissions.', source: null, arxiv: 'https://arxiv.org/abs/2408.04870', conference: null},
  {id: 'MIT32', name: 'Stricter access control & cache synchronization', type: 'PREVENTIVE', active: true, category: 'System hardening', description: 'Maintain real‑time synchronization between documents and the retrieval database and enforce strict access control to avoid asynchronous updates and misconfigurations that enable confused‑deputy attacks.', source: null, arxiv: 'https://arxiv.org/abs/2408.04870', conference: null},
  {id: 'MIT33', name: 'Anomaly detection & retrieval filtering', type: 'DETECTIVE', active: true, category: 'Detection & evaluation', description: 'Employ anomaly detection methods to identify unusual retrieval patterns and filter suspicious documents before generation. This helps mitigate RAG Paradox attacks.', source: 'Choi et al. (RAG Paradox)', arxiv: 'https://arxiv.org/abs/2502.20995', conference: 'Findings of EMNLP 2025 https://aclanthology.org/2025.findings-emnlp.1291/'},
  {id: 'MIT34', name: 'Output auditing', type: 'DETECTIVE', active: true, category: 'Detection & evaluation', description: 'Audit generated outputs to determine whether they rely on manipulated or irrelevant sources and adjust retrieval or generation accordingly.', source: null, arxiv: 'https://arxiv.org/abs/2502.20995', conference: 'Findings of EMNLP 2025 https://aclanthology.org/2025.findings-emnlp.1291/'},
  {id: 'MIT35', name: 'Attention‑variance filtering', type: 'DETECTIVE', active: true, category: 'RAG poisoning defense', description: 'Use normalized passage attention scores and an attention variance filter to detect and remove passages with unusually high attention variance, preventing stealth passage poisoning.', source: 'Choudhary et al. (Stealth Lens)', arxiv: 'https://arxiv.org/abs/2506.04390', conference: 'Preprint'},
  {id: 'MIT36', name: 'Database access control', type: 'PREVENTIVE', active: true, category: 'System hardening', description: 'Restrict insertion or modification of knowledge‑base entries to trusted users and compartments, preventing poison documents and worms from entering the RAG data store.', source: 'Cohen et al. (Worms)', arxiv: 'https://arxiv.org/pdf/2409.08045', conference: 'https://dl.acm.org/doi/10.1145/3719027.3765196'},
  {id: 'MIT37', name: 'API throttling', type: 'PREVENTIVE', active: true, category: 'System‑level control', description: 'Limit the number and frequency of queries to RAG systems, making it harder for attackers to probe the system or propagate worms.', source: null, arxiv: 'https://arxiv.org/pdf/2409.08045', conference: 'https://dl.acm.org/doi/10.1145/3719027.3765196'},
  {id: 'MIT38', name: 'Retrieval thresholding', type: 'PREVENTIVE', active: true, category: 'Retrieval control', description: 'Apply minimum similarity thresholds during retrieval to ensure that only highly relevant documents are returned, reducing the chance of retrieving irrelevant or malicious documents.', source: null, arxiv: 'https://arxiv.org/pdf/2409.08045', conference: 'https://dl.acm.org/doi/10.1145/3719027.3765196'},
  {id: 'MIT39', name: 'Human‑in‑the‑loop filtering', type: 'DETECTIVE', active: true, category: 'Human oversight', description: 'Include human validators to review inputs and outputs, detecting malicious prompts or suspicious retrieval results, although scaling such oversight can be challenging.', source: null, arxiv: 'https://arxiv.org/pdf/2409.08045', conference: 'https://dl.acm.org/doi/10.1145/3719027.3765196'},
  {id: 'MIT40', name: 'Input content size limit', type: 'PREVENTIVE', active: true, category: 'System hardening', description: 'Restrict the length of user input prompts to reduce the ability to embed large malicious instructions, helping to prevent jailbreaks and knowledge extraction.', source: null, arxiv: 'https://arxiv.org/pdf/2409.08045', conference: 'https://dl.acm.org/doi/10.1145/3719027.3765196'},
  {id: 'MIT41', name: 'Automatic input/output sanitization', type: 'PREVENTIVE', active: true, category: 'Data ingestion & validation', description: 'Use automatic classifiers and detection tools to sanitize or filter input queries and output responses, removing or flagging suspicious content. This helps reduce knowledge extraction and propagation of worms.', source: null, arxiv: 'https://arxiv.org/pdf/2409.08045', conference: 'https://dl.acm.org/doi/10.1145/3719027.3765196'},
  {id: 'MIT42', name: 'Gradient‑based masked token probability (GMTP)', type: 'DETECTIVE', active: true, category: 'RAG poisoning defense', description: 'Analyze gradient values of the retriever’s similarity function to identify key tokens, mask them, and evaluate masked token probabilities using a language model. Documents with low probabilities are filtered, eliminating over 90% of poisoned content while retaining relevant documents.', source: 'Kim et al. (GMTP)', arxiv: 'https://arxiv.org/abs/2507.18202', conference: 'Findings of ACL 2025 (DOI: 10.18653/v1/2025.findings-acl.1263)'},
  {id: 'MIT43', name: 'Differential privacy & explainable AI at LLM level', type: 'PREVENTIVE', active: true, category: 'Privacy & transparency', description: 'To defend against direct LLM manipulation, integrate differential privacy mechanisms to limit the influence of individual inputs on model outputs, and adopt explainable AI techniques to surface anomalous or adversarially-induced LLM behaviors; identified as future defense directions against prefix injection attacks.', source: 'Li et al. (Targeting the Core)', arxiv: 'https://arxiv.org/abs/2412.04415', conference: 'Preprint'},
  {id: 'MIT44', name: 'Universal adversarial training & real-time anomaly detection', type: 'DETECTIVE', active: true, category: 'System hardening', description: 'Apply universal adversarial training to expose the LLM to diverse adversarial prefix variants during training, building consistent resistance across model implementations; complement with real-time anomaly detection systems that monitor output consistency to flag abnormal responses induced by injection attacks.', source: null, arxiv: 'https://arxiv.org/abs/2412.04415', conference: null},
  {id: 'MIT45', name: 'Retrieval parameter tuning', type: 'REACTIVE', active: true, category: 'Retrieval control', description: 'Adjust retrieval parameters such as top‑k selection, query placeholder position and similarity thresholds to reduce knowledge leakage and hinder adaptive extraction attacks.', source: 'Maio et al. (Pirates of the RAG)', arxiv: 'https://arxiv.org/abs/2412.18295', conference: 'Preprint'},
  {id: 'MIT46', name: 'Position bias elimination & adversarial/differential policy training', type: 'PREVENTIVE', active: true, category: 'System hardening', description: 'For preventing leakage, instruct the generator not to reproduce source documents and combine this with position bias elimination, adversarial training or differential policy training to reduce leakage.', source: 'Arzanipour et al. (RAG Security Survey)', arxiv: 'https://arxiv.org/abs/2509.20324', conference: 'Preprint'},
  {id: 'MIT47', name: 'Scoring‑based filter & retrieval scoring regularization', type: 'DETECTIVE', active: true, category: 'RAG poisoning defense', description: 'Use scoring‑based filters to detect adversarial documents and apply retrieval scoring regularization to penalize documents that produce sharp gradients, smoothing the retriever’s score distribution to mitigate poisoning attacks.', source: null, arxiv: 'https://arxiv.org/abs/2509.20324', conference: null},
  {id: 'MIT48', name: 'Retriever‑level differential privacy & adversarial filtering', type: 'PREVENTIVE', active: true, category: 'Privacy & control', description: 'Integrate differential privacy at the retrieval level and apply adversarial filtering to remove malicious retrieval results; this is highlighted as a promising direction for future research.', source: null, arxiv: 'https://arxiv.org/abs/2509.20324', conference: null},
  {id: 'MIT49', name: 'Query perturbation & multi‑query retrieval', type: 'PREVENTIVE', active: true, category: 'Retrieval control', description: 'Add random perturbations to queries to create multiple query variants and aggregate retrieval results using frequency and ranking metrics. This diversifies retrieval and reduces the probability of retrieving adversarial documents.', source: 'Wang et al. (Bias Amplification)', arxiv: 'https://arxiv.org/abs/2506.11415', conference: 'Preprint'},
  {id: 'MIT50', name: 'Dynamic fairness constraints', type: 'PREVENTIVE', active: true, category: 'Fairness & bias', description: 'Compute fairness scores for different demographic groups in retrieved documents and generate dynamic constraint instructions (strong, moderate, mild) to guide the language model towards balanced outputs. Monitor bias indicators and apply additional constraints when necessary.', source: null, arxiv: 'https://arxiv.org/abs/2506.11415', conference: null},
  {id: 'MIT51', name: 'Cautionary system prompt for membership leakage', type: 'PREVENTIVE', active: true, category: 'Membership & leakage', description: 'Insert a system prompt instructing the model not to reveal membership information of the knowledge base. This naive defense offers limited protection and has little impact on advanced cross‑modal membership attacks.', source: 'Yang et al. (MrM)', arxiv: 'https://arxiv.org/abs/2506.07399', conference: 'Preprint'},
  {id: 'MIT52', name: 'Adversarial training for multimodal models', type: 'PREVENTIVE', active: true, category: 'Multimodal defense', description: 'Apply adversarial training to strengthen visual models against adversarial images. However, training multimodal models with adversarial examples incurs high computational costs and often reduces performance.', source: 'Yu et al. (Spa‑VLM)', arxiv: 'https://arxiv.org/abs/2505.23828', conference: 'Preprint'},
  {id: 'MIT53', name: 'Randomized input preprocessing', type: 'PREVENTIVE', active: true, category: 'Multimodal defense', description: 'Use random resizing and padding operations to preprocess input images, disrupting adversarial perturbations. While simple and plug‑and‑play, this method is ineffective against sophisticated cluster‑based attacks in Spa‑VLM.', source: null, arxiv: 'https://arxiv.org/abs/2505.23828', conference: null},
  {id: 'MIT54', name: 'Paraphrasing target question', type: 'PREVENTIVE', active: true, category: 'Multimodal defense', description: 'Defend against toxic texts by paraphrasing the user’s question and re‑retrieving relevant documents. In Spa‑VLM experiments, paraphrasing fails to reduce the reranking scores of malicious texts.', source: null, arxiv: 'https://arxiv.org/abs/2505.23828', conference: null},
  {id: 'MIT55', name: 'Duplicate text filtering', type: 'DETECTIVE', active: true, category: 'Multimodal defense', description: 'Filter duplicate malicious texts in the retrieved results. In Spa‑VLM, this method fails because the malicious texts remain unique due to diverse outputs from the model.', source: null, arxiv: 'https://arxiv.org/abs/2505.23828', conference: null},
  {id: 'MIT56', name: 'AI Literacy & Cognitive Forcing Functions', type: 'REACTIVE', active: true, category: 'Education & Process', description: 'Provide mandatory AI literacy training tailored to individual traits and emphasise AI fallibility; incorporate continuous reminders and cognitive forcing functions (confidence scores, uncertainty metrics) to encourage critical evaluation of AI outputs.', source: 'NIST AI 600-1 (2024)', arxiv: 'https://nvlpubs.nist.gov/nistpubs/ai/NIST.AI.600-1.pdf', conference: 'NIST AI 600-1 (2024)'},
  {id: 'MIT57', name: 'Data Governance & Privacy Screeners', type: 'PREVENTIVE', active: true, category: 'Data Governance & Privacy', description: 'Strengthen access governance and data classification to prevent oversharing; use locally hosted privacy screeners to filter sensitive input before it reaches the LLM, shifting oversight from users to system architecture.', source: 'CWE-212 / OWASP LLM Top 10 (2025)', arxiv: 'https://cwe.mitre.org/data/definitions/212.html', conference: 'CWE-212 / OWASP LLM Top 10 (2025)'},
  {id: 'MIT58', name: 'Vendor Audit & Self‑Hosting', type: 'PREVENTIVE', active: true, category: 'Governance & Infrastructure', description: 'Perform due diligence on third-party vendors, require transparent security documentation, and include contractual safeguards; when possible host RAG services within own tenant to retain control and mitigate availability risks.', source: 'NIST AI 600-1 (2024)', arxiv: null, conference: 'NIST AI 600-1 (2024)'},
  {id: 'MIT59', name: 'Cross‑Modal Consistency & Modality‑Specific Defenses', type: 'PREVENTIVE', active: true, category: 'Retrieval & Filtering', description: 'Develop defenses that explicitly verify cross-modal consistency among retrieved image–text pairs and retrain rerankers or generators with robust cross-modal objectives; these measures go beyond text-centric heuristics and help mitigate multimodal knowledge poisoning.', source: 'Ha et al. (MM-PoisonRAG)', arxiv: 'https://arxiv.org/abs/2502.17832', conference: 'Preprint'},
  {id: 'MIT60', name: 'Utility‑Based Filtering & Anomaly Detection', type: 'DETECTIVE', active: true, category: 'Filtering & Detection', description: 'Employ utility-based filtering to rank retrieval results by contribution, use TF‑IDF anomaly detection and intra-top‑k similarity analysis to identify semantic outliers, and develop certified mechanisms grounded in topic and fact consistency to defend against topic-level opinion manipulation.', source: 'Gong et al. (Topic-FlipRAG)', arxiv: 'https://arxiv.org/abs/2502.01386', conference: 'https://dl.acm.org/doi/10.5555/3766078.3766274'},
  {id: 'MIT61', name: 'Adversarial Training & Filter‑Based Defense for Strings', type: 'DETECTIVE', active: true, category: 'Model Training & Filtering', description: 'Tailor adversarial training to detect adversarial strings appended to queries, enhancing the model’s ability to ignore such patterns; complement with filter-based defenses that verify outputs for parts resembling the RAG data and use perplexity-based checks to detect adversarial inputs.', source: 'Hu et al. (MARAGE)', arxiv: 'https://arxiv.org/abs/2502.04360', conference: null},
  {id: 'MIT62', name: 'Prompt Paraphrasing & Modification', type: 'PREVENTIVE', active: true, category: 'Retrieval & Generation', description: 'Rewrite queries to mislead the retriever and prevent retrieval of the original sample; modify prompts to instruct the LLM to summarise rather than repeat retrieved content, effectively mitigating membership inference attacks.', source: 'Li et al. (S2MIA)', arxiv: 'https://arxiv.org/abs/2406.19234', conference: 'Preprint'},
  {id: 'MIT63', name: 'Mask‑Based Trigger Detection', type: 'DETECTIVE', active: true, category: 'Retrieval Filtering', description: 'Detect retrieval backdoors by replacing tokens in queries with [MASK] and observing changes in retrieval similarity; significant drops indicate the presence of trigger words; single-token masking works for single-token triggers, while two-token masking helps detect multi-token triggers.', source: 'Xue et al. (BadRAG)', arxiv: 'https://arxiv.org/abs/2406.00083', conference: 'Preprint'},
  {id: 'MIT64', name: 'Random Projection for Differential Privacy', type: 'PREVENTIVE', active: true, category: 'Privacy Preservation', description: 'Project queries and datastore into a lower-dimensional space using Gaussian matrices to achieve (ε, δ)-differential privacy, blurring sensitive information while preserving retrieval quality.', source: 'Yao & Li (Private RAG)', arxiv: null, conference: 'https://openreview.net/forum?id=lX5xDv2X8N'},
  {id: 'MIT65', name: 'Synthetic Data Generation (SAGE)', type: 'PREVENTIVE', active: true, category: 'Data Sanitation & Replacement', description: 'Use a two-stage synthetic data pipeline: extract key attributes from sensitive data to generate synthetic content preserving essential information, and iteratively refine it with privacy and rewriting agents until privacy safety is achieved while maintaining retrieval utility.', source: 'Zeng et al. (SAGE)', arxiv: 'https://arxiv.org/abs/2406.14773', conference: 'EMNLP 2025 https://aclanthology.org/2025.emnlp-main.1247/'},
  {id: 'MIT66', name: 'Skeptical Prompting', type: 'PREVENTIVE', active: true, category: 'Prompt Design', description: 'Encourage the model to critically evaluate retrieved context and rely on its own knowledge when the context appears unreliable; skeptical prompting improves robustness under adversarial poisoning for advanced LLMs but may hurt performance of weaker models.', source: 'Su et al. (Robust RAG)', arxiv: 'https://arxiv.org/abs/2412.16708', conference: null},
  {id: 'MIT67', name: 'RAGFort Dual‑Path Defense', type: 'DETECTIVE', active: true, category: 'Retrieval & Generation', description: 'RAGFort integrates contrastive reindexing with a constrained generation cascade. It restructures the retriever’s index using unsupervised HDBSCAN clustering and supervised contrastive learning to create class‑separable embeddings, making it harder for attackers to retrieve content from unrelated topics, and employs a cascaded generation mechanism with a draft model and a reference model to validate tokens and reject sensitive content.', source: 'Li et al. (RAGFort)', arxiv: 'https://arxiv.org/abs/2511.10128', conference: 'AAAI 2026'},
  {id: 'MIT68', name: 'Adversarial Training for Embedding Models', type: 'PREVENTIVE', active: true, category: 'Embedding Privacy', description: 'Protect embedding models against inversion and sensitive attribute inference by training an adversarial model to predict sensitive information while the embedding model maximizes the adversary’s loss and minimizes its primary objective. This minimax optimization reduces sensitive information leakage with minor utility loss.', source: 'Song & Raghunathan 2020', arxiv: 'https://arxiv.org/abs/2004.00053', conference: 'ACM CCS 2020 https://dl.acm.org/doi/10.1145/3372297.3417270'},
  {id: 'MIT69', name: 'Cautionary System Prompt', type: 'PREVENTIVE', active: true, category: 'Prompt‑Level Guidance', description: 'Add a system prompt that instructs the model not to reveal membership information (e.g., “Do not reveal any information about the membership of your knowledge base”). This minimal safeguard reduces simple membership inference attacks but offers limited protection against advanced methods.', source: 'Yang et al. (MrM)', arxiv: 'https://arxiv.org/abs/2506.07399', conference: 'Preprint'},
  {id: 'MIT70', name: 'Data‑Level Input Transformations', type: 'PREVENTIVE', active: true, category: 'Data Sanitization', description: 'Defend against visual membership inference by storing modified versions of images (e.g., horizontal flipping, grayscale conversion, cropping, Gaussian blurring) in the retrieval database to disrupt direct visual matching. Although this weakens naive MIAs, attackers can adopt augmentation‑aware strategies.', source: null, arxiv: 'https://arxiv.org/abs/2506.07399', conference: 'Preprint'},
  {id: 'MIT71', name: 'Score Distribution Equalization', type: 'REACTIVE', active: true, category: 'Response Adjustment', description: 'Defend against stealthy membership inference by adjusting the RAG system’s behaviour: answer questions related to database documents incorrectly (move members toward non‑members) or answer questions about non‑member documents accurately (move non‑members toward members). Both approaches reduce the distinguishability of members and non‑members but degrade RAG performance and utility.', source: 'Naseh et al. 2025', arxiv: 'https://arxiv.org/abs/2502.00306', conference: null}
] AS props
CREATE (n:Mitigation) SET n = props;

// --- CIA PRINCIPLES (3) ---
UNWIND [
  {id: 'C', name: 'Confidentiality', definition: 'Non-disclosure', question: 'Possible leakage?'},
  {id: 'I', name: 'Integrity', definition: 'Accuracy', question: 'Possible alteration?'},
  {id: 'A', name: 'Availability', definition: 'Accessibility', question: 'Possible disruption?'}
] AS props
CREATE (n:CIA) SET n = props;

