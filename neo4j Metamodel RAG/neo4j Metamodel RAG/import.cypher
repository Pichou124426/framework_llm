  {id: 'CWE-212', name: 'Improper Removal of Sensitive Information Before Storage or Transfer', source: 'MITRE CWE', severity: 3, capec: 'CAPEC-118'},
  {id: 'CWE-345', name: 'Insufficient Verification of Data Authenticity', source: 'MITRE CWE', severity: 3, capec: 'CAPEC-141'},
  {id: 'CWE-400', name: 'Uncontrolled Resource Consumption', source: 'MITRE CWE', severity: 3, capec: 'CAPEC-125'},
  {id: 'CWE-693', name: 'Protection Mechanism Failure', source: 'MITRE CWE', severity: 4, capec: 'CAPEC-242'},
  {id: 'CWE-770', name: 'Allocation of Resources Without Limits or Throttling', source: 'MITRE CWE', severity: 3, capec: 'CAPEC-125'},
  {id: 'CWE-863', name: 'Incorrect Authorization', source: 'MITRE CWE', severity: 4, capec: 'CAPEC-242'},
