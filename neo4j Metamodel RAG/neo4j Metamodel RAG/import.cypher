// --- GENERATES secondary (Attack -> Risk, 8 links) ---
// An attack generates a primary risk (above) and may also generate
// secondary risks on different assets or CIA dimensions.
UNWIND [
  {source: 'ATT.INJ.1', target: 'R6', type: 'secondary', justification: 'Injection can also disclose corpus data (I->C, OUTPUT->CORPUS)'},
  {source: 'ATT.INJ.3', target: 'R27', type: 'secondary', justification: 'ACL bypass exposes documents from higher privilege levels (I+C->C, OUTPUT->CORPUS)'},
  {source: 'ATT.POI.1', target: 'R1', type: 'secondary', justification: 'A corrupted corpus also degrades responses (I->A, CORPUS->OUTPUT)'},
  {source: 'ATT.POI.7', target: 'R22', type: 'secondary', justification: 'Source exposure facilitates adaptive extraction (reconnaissance->exfiltration)'},
  {source: 'ATT.POI.14', target: 'R1', type: 'secondary', justification: 'Partially correct evidence degrades responses (I->A, CORPUS->OUTPUT)'},
  {source: 'ATT.POI.15', target: 'R1', type: 'secondary', justification: 'Inter-source contradictions degrade responses (I->A, CORPUS->OUTPUT) -- same SafeRAG cascade as POI.14'},
  {source: 'ATT.EXF.8', target: 'R4', type: 'secondary', justification: 'Over-indexing reveals document membership (CORPUS->MEMBERSHIP)'},
  {source: 'ATT.EXF.9', target: 'R4', type: 'secondary', justification: 'Verbatim extraction implies membership knowledge (CORPUS->MEMBERSHIP)'}
] AS rel
MATCH (a:Attack {id: rel.source}), (b:Risk {id: rel.target})
CREATE (a)-[:GENERATES {type: rel.type, justification: rel.justification}]->(b);

