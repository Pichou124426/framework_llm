// ============================================
// RAG Security Knowledge Base -- Neo4j Import
// Version: 5.2.0 (generated from CSV datasets)
// Entities: RAG, Surface (8), Attack (38), Risk (41), Weakness (12 CWE), Mitigation (72), CIA
// Generated by: generate_import_cypher.py
// Source CSVs: risks, mitigations, attacks, surfaces, weaknesses, enables, corrects
// ============================================

// --- CLEAN DATABASE ---
MATCH (n) DETACH DELETE n;

// --- CONSTRAINTS ---
CREATE CONSTRAINT IF NOT EXISTS FOR (n:RAG) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Surface) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Attack) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Risk) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Weakness) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Mitigation) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT IF NOT EXISTS FOR (n:CIA) REQUIRE n.id IS UNIQUE;

// --- INDEXES ---
CREATE INDEX IF NOT EXISTS FOR (r:Risk) ON (r.category);
CREATE INDEX IF NOT EXISTS FOR (r:Risk) ON (r.asset);
CREATE INDEX IF NOT EXISTS FOR (a:Attack) ON (a.category);
CREATE INDEX IF NOT EXISTS FOR (m:Mitigation) ON (m.type);
CREATE INDEX IF NOT EXISTS FOR (w:Weakness) ON (w.type);

// --- RAG VARIANTS (3) ---
UNWIND [
  {id: 'TEXTUAL', name: 'Textual RAG', description: 'Classic textual RAG (merging Naive + Advanced + Modular). Pipeline: Indexation -> Retrieval -> Generation on textual documents.', source: 'Gao et al. 2024 (arXiv:2312.10997)'},
  {id: 'GRAPHRAG', name: 'GraphRAG', description: 'Knowledge-graph-based RAG. Adds KG-specific surfaces (M3.graph) to textual surfaces.', source: 'Edge et al. 2024 (Microsoft GraphRAG)'},
  {id: 'MULTIMODAL', name: 'Multimodal RAG', description: 'Multimodal RAG processing text, images and audio. Inherits textual surfaces and adds M3.multi.', source: 'Meta-Model Synthesis v5.0'}
] AS props
CREATE (n:RAG) SET n = props;

// --- NOTE: Category is an attribute of Attack (not a separate entity) ---
// Categories: INJ (Injection), POI (Poisoning), INF (Inference),
//             EXF (Exfiltration), DEG (Degradation), UNK (Unknown)

// --- SURFACES (8) ---
UNWIND [
  {id: 'M1', name: 'Document Acquisition', type: 'DOCUMENT', description: 'Document ingestion into the RAG pipeline', source: 'Lewis et al. 2020, OWASP Attack Surface Analysis', code: 'S-DOC', module: 'M1'},
  {id: 'M2', name: 'Preprocessing / Normalization', type: 'DOCUMENT', description: 'Parsing, chunking, and cleaning of ingested documents', source: 'Gao et al. 2024, LlamaIndex Node Parsers', module: 'M2'},
  {id: 'M3', name: 'Indexation (Vector Store)', type: 'DATABASE', description: 'Embedding encoding and vector storage', source: 'Johnson et al. 2019 (FAISS), Gao et al. 2024', module: 'M3'},
  {id: 'M4', name: 'Query Optimization', type: 'API', description: 'Rewriting and expansion of the user query', source: 'Ma et al. 2023, Gao et al. 2024', code: 'S-QUERY', module: 'M4'},
  {id: 'M5', name: 'Retrieval', type: 'API', description: 'Relevant document search in the vector store', source: 'Lewis et al. 2020, Karpukhin et al. 2020 (DPR)', code: 'S-RETR', module: 'M5'},
  {id: 'M6', name: 'Post-Retrieval (reranking filtering)', type: 'API', description: 'Reranking and filtering of retrieved documents', source: 'Glass et al. 2022, Gao et al. 2024', module: 'M6'},
  {id: 'M7', name: 'Generation (LLM)', type: 'API', description: 'Response generation by the LLM', source: 'Lewis et al. 2020', code: 'S-GEN', module: 'M7'},
  {id: 'Tx', name: 'Cross-cutting Modules', type: 'SYSTEM', description: 'Conversational memory, orchestration, monitoring', source: 'Park et al. 2023, LangChain Agents', module: 'Tx'}
] AS props
CREATE (n:Surface) SET n = props;

// --- WEAKNESSES / CWE (12) ---
// Aligned with SYNTHESE v5.0 Table 4.2b (Category -> CWE -> CAPEC mapping)
UNWIND [
  {id: 'CWE-74', name: 'Improper Neutralization of Special Elements in Output Used by a Downstream Component', source: 'MITRE CWE', severity: 4, capec: 'CAPEC-242'},
  {id: 'CWE-94', name: 'Improper Control of Generation of Code (Code Injection)', source: 'MITRE CWE', severity: 4, capec: 'CAPEC-242'},
